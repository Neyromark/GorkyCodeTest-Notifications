# Скопируйте в .env: cp .env.example .env

# --- PostgreSQL (хранилище запланированных джоб) ---
# Пароль должен совпадать с POSTGRES_PASSWORD в Database/.env
POSTGRES_PASSWORD=change-me
POSTGRES_USER=postgres
POSTGRES_DB=tasks_db
# Для локального запуска без Docker; в docker compose хост и порт
# переопределяются на postgres:5432
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Доставка в бота ---
NOTIFICATION_SERVICE_URL=http://vkbottle_bot/api/v1/send-message
# Bearer-токен для бота; пусто — заголовок Authorization не отправляется
AUTH_TOKEN=
REQUEST_TIMEOUT=10

# --- Повторные попытки ---
MAX_DELIVERY_ATTEMPTS=5
# Задержка перед первым повтором в секундах, дальше удваивается
RETRY_BASE_DELAY=30
# Не отправлять напоминание, если событие началось больше N секунд назад
STALE_AFTER_SECONDS=900

# --- Прочее ---
# Часовой пояс планировщика (время в сообщениях всегда по Москве)
TIMEZONE=UTC
# Порт сервиса на хосте: 8000 занят Backend, поэтому 8080
APP_PORT=8080
